    {
        "id": "1af31f8381691ff0",
        "type": "function",
        "z": "99522873b017cfd6",
        "name": "Préparer ligne alertes.csv",
        "func": "// L'alerte arrive directement depuis le nœud de filtrage.\nconst typeAlerte = String(msg.payload || \"\")\n    .trim()\n    .toUpperCase();\n\n// Enregistrer uniquement les alertes utiles.\nif (\n    typeAlerte !== \"AVERTISSEMENT\"\n    && typeAlerte !== \"ANOMALIE_CRITIQUE\"\n    && typeAlerte !== \"DONNEE_INVALIDE\"\n) {\n    node.status({\n        fill: \"grey\",\n        shape: \"ring\",\n        text: \"alerte ignorée : \" + typeAlerte\n    });\n\n    return null;\n}\n\n// Date et heure locales.\nconst maintenant = new Date();\n\nconst date = maintenant.toLocaleDateString(\n    \"fr-FR\",\n    {\n        day: \"2-digit\",\n        month: \"2-digit\",\n        year: \"numeric\"\n    }\n);\n\nconst heure = maintenant.toLocaleTimeString(\n    \"fr-FR\",\n    {\n        hour: \"2-digit\",\n        minute: \"2-digit\",\n        second: \"2-digit\",\n        hour12: false\n    }\n);\n\n// Dernières valeurs reçues et mémorisées.\nconst temperature =\n    flow.get(\"temperature\") ?? \"\";\n\nconst vibration =\n    flow.get(\"vibration\") ?? \"\";\n\nconst etat =\n    flow.get(\"etat\") ?? \"\";\n\n// Construction directe d'une ligne CSV.\nmsg.payload =\n    date + \";\"\n    + heure + \";\"\n    + typeAlerte + \";\"\n    + temperature + \";\"\n    + vibration + \";\"\n    + etat\n    + \"\\n\";\n\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: \"ligne CSV prête\"\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
