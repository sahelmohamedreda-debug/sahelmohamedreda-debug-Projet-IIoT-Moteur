    {
        "id": "f22d703be8195f0f",
        "type": "function",
        "z": "99522873b017cfd6",
        "name": "Afficher alerte en couleur",
        "func": "const alerte = String(msg.payload).trim();\n\nif (alerte === \"ANOMALIE_CRITIQUE\") {\n    msg.payload = {\n        texte: \"ANOMALIE CRITIQUE\",\n        couleur: \"#d32f2f\",\n        couleurTexte: \"#ffffff\"\n    };\n\n    node.status({\n        fill: \"red\",\n        shape: \"dot\",\n        text: \"ANOMALIE CRITIQUE\"\n    });\n}\nelse if (alerte === \"AVERTISSEMENT\") {\n    msg.payload = {\n        texte: \"AVERTISSEMENT\",\n        couleur: \"#ff9800\",\n        couleurTexte: \"#000000\"\n    };\n\n    node.status({\n        fill: \"yellow\",\n        shape: \"dot\",\n        text: \"AVERTISSEMENT\"\n    });\n}\nelse {\n    msg.payload = {\n        texte: \"AUCUNE ALERTE\",\n        couleur: \"#2e7d32\",\n        couleurTexte: \"#ffffff\"\n    };\n\n    node.status({\n        fill: \"green\",\n        shape: \"dot\",\n        text: \"AUCUNE ALERTE\"\n    });\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
        "y": 120,
