    {
        "id": "26ee8089e92e7db9",
        "type": "function",
        "z": "99522873b017cfd6",
        "name": "Construire ligne CSV",
        "func": "const temperature = flow.get(\"temperature\");\nconst vibration = flow.get(\"vibration\");\nconst etat = flow.get(\"etat\");\nconst fonctionnement = flow.get(\"fonctionnement\");\nconst alerte = flow.get(\"alerte\");\n\n// Affichage temporaire pour identifier une donnée manquante\nif (temperature === undefined) {\n    node.status({\n        fill: \"red\",\n        shape: \"ring\",\n        text: \"temperature manquante\"\n    });\n    return null;\n}\n\nif (vibration === undefined) {\n    node.status({\n        fill: \"red\",\n        shape: \"ring\",\n        text: \"vibration manquante\"\n    });\n    return null;\n}\n\nif (etat === undefined) {\n    node.status({\n        fill: \"red\",\n        shape: \"ring\",\n        text: \"etat manquant\"\n    });\n    return null;\n}\n\nif (fonctionnement === undefined) {\n    node.status({\n        fill: \"red\",\n        shape: \"ring\",\n        text: \"fonctionnement manquant\"\n    });\n    return null;\n}\n\nif (alerte === undefined) {\n    node.status({\n        fill: \"red\",\n        shape: \"ring\",\n        text: \"alerte manquante\"\n    });\n    return null;\n}\n\nconst maintenant = new Date();\n\nmsg.payload = {\n    date: maintenant.toLocaleDateString(\"fr-FR\"),\n    heure: maintenant.toLocaleTimeString(\"fr-FR\"),\n    temperature: Number(temperature),\n    vibration: Number(vibration),\n    etat: String(etat),\n    fonctionnement: String(fonctionnement),\n    alerte: String(alerte)\n};\n\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: \"ligne construite\"\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 740,
        "wires": [
            [
                "c9e7f2e87d4be65a",
                "3b2c1bc79033088d"
            ]
        ]
    },
