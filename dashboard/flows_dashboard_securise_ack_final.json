    {
        "id": "decdd2afea60b5d1",
        "type": "function",
        "z": "99522873b017cfd6",
        "name": "Formater ACK Commande",
        "func": "let ack = msg.payload;\n\nif (typeof ack === \"string\") {\n    try {\n        ack = JSON.parse(ack);\n    } catch (erreur) {\n        node.status({\n            fill: \"red\",\n            shape: \"ring\",\n            text: \"ACK JSON invalide\"\n        });\n\n        return null;\n    }\n}\n\nconst commande = ack.commande || \"INCONNUE\";\nconst resultat = ack.resultat || \"INCONNU\";\nconst raison = ack.raison || \"NON_PRECISEE\";\nconst fonctionnement =\n    ack.fonctionnement || \"INCONNU\";\n\nmsg.ack = ack;\n\nif (resultat === \"ACCEPTEE\") {\n    msg.payload =\n        \"✅ \" + commande\n        + \" acceptée\"\n        + \" • \" + fonctionnement;\n\n    node.status({\n        fill: \"green\",\n        shape: \"dot\",\n        text: commande + \" acceptée\"\n    });\n} else {\n    msg.payload =\n        \"❌ \" + commande\n        + \" refusée\"\n        + \" • \" + raison\n        + \" • \" + fonctionnement;\n\n    node.status({\n        fill: \"red\",\n        shape: \"dot\",\n        text: commande + \" refusée\"\n    });\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
